# Copiá este archivo como .env y completá los valores.

# --- General ---
NOMBRE_ESTUDIO=Saez Sanchez Arquitectos
SECRET_KEY=cambiar-por-una-clave-larga-y-secreta
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Dirección con la que se arman los links de los emails y WhatsApp.
# Mientras corra solo en esta PC, los clientes no van a poder abrirlos desde afuera.
SITIO_URL=http://127.0.0.1:8000
ZONA_HORARIA=America/Argentina/Buenos_Aires

# --- Email ---
# En desarrollo los emails se guardan como archivos en data/emails/ (no se envían).
# Para enviarlos de verdad (ej. Gmail con "clave de aplicación"):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=tu-cuenta@gmail.com
# EMAIL_HOST_PASSWORD=clave-de-aplicacion
DEFAULT_FROM_EMAIL=Estudio <no-responder@estudio.local>

# --- WhatsApp ---
# simulado   -> escribe los mensajes en data/whatsapp_simulado.log (no envía nada)
# meta       -> WhatsApp Cloud API de Meta (requiere cuenta Business y plantilla aprobada)
# desactivado
WHATSAPP_BACKEND=simulado
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# Plantilla aprobada por Meta con 2 variables en el cuerpo: {{1}} = título, {{2}} = link
# WHATSAPP_PLANTILLA=aviso_estudio
# WHATSAPP_IDIOMA=es_AR

# --- Tareas en segundo plano ---
# true  -> los envíos se hacen en el momento (no hace falta nada más)
# false -> se encolan; hay que dejar corriendo tareas.bat (también hace los recordatorios diarios)
TAREAS_INMEDIATAS=true

# Días que dura un link de aprobación enviado por email/WhatsApp
ENLACE_DIAS_VALIDEZ=7
# Tamaño máximo por archivo subido (MB)
MAX_ARCHIVO_MB=300
